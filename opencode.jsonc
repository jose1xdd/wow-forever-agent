{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-sol",
  "default_agent": "azeroth-companion",
  "mcp": {
    "servers": {
      "azeroth": {
        "type": "local",
        "command": ["docker", "compose", "run", "--rm", "-T", "mcp"],
        "timeout": { "startup": 120000, "execution": 600000 }
      }
    }
  }
}
